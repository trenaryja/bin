{
	"name": "bin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun build.ts",
		"fix": "bun run format && eslint --fix .",
		"check": "tsc --noEmit && bun run format:check && bun run lint",
		"lint": "eslint . --max-warnings=0 && golangci-lint run ./... && cargo clippy --all-targets -- -D warnings",
		"format": "prettier -w . && gofmt -w $(find . -name '*.go' -not -path './vendor/*') && cargo fmt",
		"format:check": "prettier -c . && gofmt -l $(find . -name '*.go' -not -path './vendor/*') | diff /dev/null - && cargo fmt --check",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install"
	},
	"dependencies": {
		"@clack/core": "^1.4.3",
		"@clack/prompts": "^1.7.0",
		"@trenaryja/ui": "^0.0.1-37",
		"chalk": "^6.0.0",
		"chroma-js": "^3.2.0",
		"cosmiconfig": "^10.0.1",
		"ink": "^7.1.1",
		"ink-select-input": "^6.2.0",
		"ink-text-input": "^6.0.0",
		"inquirer": "^14.2.0",
		"ollama": "^0.6.3",
		"react": "^19.2.8",
		"remeda": "^2.45.0",
		"sharp": "^0.35.4",
		"type-fest": "^5.9.0",
		"wrap-ansi": "^10.0.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@trenaryja/config": "^0.0.4",
		"@types/chroma-js": "^3.1.2",
		"@types/react": "^19.2.18",
		"@types/sharp": "^0.32.0",
		"react-devtools-core": "^7.0.1"
	},
	"prettier": "@trenaryja/config/prettier"
}
