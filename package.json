{
	"name": "bin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun build.ts",
		"lint": "eslint . && golangci-lint run ./... && cargo clippy --all-targets -- -D warnings",
		"check": "tsc --noEmit && bun run format:check && bun run lint",
		"format": "prettier -w . !\"bun.lockb\" && gofmt -w $(find . -name '*.go' -not -path './vendor/*') && cargo fmt",
		"format:check": "prettier -c . !\"bun.lockb\" && gofmt -l $(find . -name '*.go' -not -path './vendor/*') | diff /dev/null - && cargo fmt --check",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"@trenaryja/ui": "^0.0.1-35",
		"chalk": "^5.6.2",
		"chroma-js": "^3.2.0",
		"cosmiconfig": "^9.0.1",
		"ink": "^7.0.0",
		"ink-select-input": "^6.2.0",
		"ink-text-input": "^6.0.0",
		"inquirer": "^13.4.1",
		"ollama": "^0.6.3",
		"react": "^19.2.5",
		"sharp": "^0.34.5",
		"type-fest": "^5.5.0",
		"wrap-ansi": "^10.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fullstacksjs/eslint-config": "^14.2.0",
		"@types/chroma-js": "^3.1.2",
		"@types/react": "^19.2.14",
		"@types/sharp": "^0.32.0",
		"bun-types": "^1.3.11",
		"eslint": "^10.2.0",
		"prettier": "^3.8.1",
		"react-devtools-core": "^7.0.1",
		"typescript": "^6.0.2"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"printWidth": 120,
		"jsxSingleQuote": true,
		"useTabs": true
	}
}
