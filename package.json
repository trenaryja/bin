{
	"name": "bin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun build.ts",
		"lint": "eslint .",
		"check": "tsc --noEmit && bun run format -c && bun run lint",
		"format": "prettier -w . !\"bun.lockb\"",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install"
	},
	"dependencies": {
		"@clack/prompts": "^0.9.1",
		"chalk": "^5.4.1",
		"inquirer": "^12.5.2",
		"ora": "^8.2.0",
		"type-fest": "^5.4.4",
		"wrap-ansi": "^10.0.0"
	},
	"devDependencies": {
		"@fullstacksjs/eslint-config": "^14.0.0",
		"bun-types": "^1.3.11",
		"eslint": "^9.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"printWidth": 120,
		"jsxSingleQuote": true,
		"useTabs": true
	}
}
